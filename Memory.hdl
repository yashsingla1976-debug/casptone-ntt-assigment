CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[13..14]: 00,01 -> RAM16K ; 10 -> Screen ; 11 -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=l0, b=l1, c=l2, d=l3);
    Or(a=l0, b=l1, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=l2, address=address[0..12], out=scrOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=scrOut, d=kbdOut,
              sel=address[13..14], out=out);
}
